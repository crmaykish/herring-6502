// Herring-F pin constraints - Tang Nano 9k

// 27 MHz onboard oscillator (PLL reference)
IO_LOC  "clk_27" 52;
IO_PORT "clk_27" IO_TYPE=LVCMOS33;

// 6 onboard LEDs (active-low). Bank 3 VCCIO is fixed at 1.8V on the 9k -> LVCMOS18
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// BL702 USB-UART bridge. FPGA TX = pin 17, FPGA RX = pin 18
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard microSD (TF) slot
// IO_LOC  "sd_cs" 38;
// IO_PORT "sd_cs" IO_TYPE=LVCMOS33 DRIVE=8;
// IO_LOC  "sd_mosi" 37;
// IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
// IO_LOC  "sd_sck" 36;
// IO_PORT "sd_sck" IO_TYPE=LVCMOS33 DRIVE=8;
// IO_LOC  "sd_miso" 39;
// IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
